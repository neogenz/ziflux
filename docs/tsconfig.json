{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "astro.config.mjs", "src/**/*"],
  "exclude": ["dist", "out", ".next", "node_modules"],
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@/*": ["src/*"]
    }
  }
}
